# Docker Compose environment overrides
# Copy this file to .env and set real values

# Database
DB_USERNAME=amit
DB_PASSWORD=<your-db-password>

# HMAC signing key (Base64-encoded 32-byte key)
HMAC_KEY_BASE64=<your-base64-hmac-key>

# AWS
AWS_REGION=ap-south-1
AWS_KMS_KEY_ID=arn:aws:kms:ap-south-1:<account-id>:key/<key-id>
